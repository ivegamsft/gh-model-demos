# Local secrets. Commit only sanitized templates.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.npmrc
.netrc
_netrc
.git-credentials
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# Authentication caches and agent session state, not shared .github assets.
.ssh/
.aws/
.azure/
.config/gh/
.copilot/
.claude/.credentials.json
.claude/settings.local.json
.auth/

# Harness evidence can contain prompts, model outputs, and sensitive tool results.
results/
node_modules/
.build-packages/

# Harness/runtime noise outside results/. Do not ignore *.log globally:
# fixtures/**/*.log are committed test inputs.
*.tmp
runner.lock
coverage/
.nyc_output/
npm-debug.log*
*.tgz

# Copilot CLI local exports (--share transcripts, --usage-output-file JSON).
copilot-session-*.md
copilot-usage*.json

# OS and editor clutter.
.DS_Store
Thumbs.db
desktop.ini

# Local previews and Python bytecode.
.playwright-mcp/
__pycache__/
*.py[cod]
